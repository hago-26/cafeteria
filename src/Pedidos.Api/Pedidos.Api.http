# 400: producto 6 no disponible y 999 no existe
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [
    { "productoId": 6, "cantidad": 1 },
    { "productoId": 999, "cantidad": 1 }
  ]
}


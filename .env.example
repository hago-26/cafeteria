# Copia este archivo a .env y cambia los valores.
# .env NUNCA se versiona (está en .gitignore). Este .env.example SÍ.

# Docker Hub (se usa desde la etapa 15)
DOCKERHUB_USER=tu-usuario

# db-catalogo
CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=cambia-esto-catalogo

# db-pedidos
PEDIDOS_DB_NAME=pedidos
PEDIDOS_DB_USER=pedidos
PEDIDOS_DB_PASSWORD=cambia-esto-pedidos

# Puertos del host SOLO para desarrollo local (etapa 0). Más adelante las BD no se publican.
CATALOGO_DB_PORT=5433
PEDIDOS_DB_PORT=5434
